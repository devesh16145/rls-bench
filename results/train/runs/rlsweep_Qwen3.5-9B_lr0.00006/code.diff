+
+create or replace function public.is_mechanic(p_garage_id bigint)
+returns boolean
+language sql
+stable
+security definer
+set search_path = public
+as $$
+  select exists (
+    select 1
+    from public.mechanics m
+    where m.garage_id = p_garage_id
+      and m.user_id = auth.uid()
+  );
+$$;
+
+revoke all on function public.is_mechanic(bigint) from public, anon;
+grant execute on function public.is_mechanic(bigint) to authenticated, service_role;
+
+create or replace function public.jobs_enforce_update()
+returns trigger
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_is_customer boolean := (old.customer_id = auth.uid());
+  v_is_mechanic boolean := public.is_mechanic(old.garage_id);
+begin
+  if coalesce(auth.role(), '') = 'service_role' then
+    return new;
+  end if;
+
+  if new.id is distinct from old.id then
+    raise exception 'job id cannot be changed';
+  end if;
+
+  if v_is_customer
+     and old.status = 'quoted'
+     and new.status = 'approved'
+     and new.customer_id = old.customer_id
+     and new.garage_id = old.garage_id
+     and new.vehicle = old.vehicle
+     and new.quote_amount = old.quote_amount
+  then
+    return new;
+  end if;
+
+  if v_is_mechanic
+     and new.customer_id = old.customer_id
+     and new.garage_id = old.garage_id
+     and new.vehicle = old.vehicle
+  then
+    if old.status = 'quoted'
+       and new.status = 'quoted'
+    then
+      return new;
+    elsif old.status = 'approved'
+       and new.status = 'in_progress'
+       and new.quote_amount = old.quote_amount
+    then
+      return new;
+    elsif old.status = 'in_progress'
+       and new.status = 'done'
+       and new.quote_amount = old.quote_amount
+    then
+      return new;
+    end if;
+  end if;
+
+  raise exception 'job update violates allowed transitions';
+end;
+$$;
+
+create trigger jobs_enforce_update
+before update on public.jobs
+for each row execute function public.jobs_enforce_update();
