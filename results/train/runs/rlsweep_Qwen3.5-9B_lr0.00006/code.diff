+-- R1: patients read their own patient row (any assurance level)
+create policy patients_select_own
+on public.patients
+for select
+to authenticated
+using (user_id = auth.uid());
+
+-- R2: care-team doctors read patient rows, aal2 only
+create policy patients_select_doctor_aal2
+on public.patients
+for select
+to authenticated
+using (public.current_session_is_aal2() and public.is_care_team_doctor(id));
+
+-- R1: patients read their own records (any assurance level)
+create policy records_select_own
+on public.records
+for select
+to authenticated
+using (public.owns_patient(patient_id));
+
+-- R2: care-team doctors read records, aal2 only
+create policy records_select_doctor_aal2
+on public.records
+for select
+to authenticated
+using (public.current_session_is_aal2() and public.is_care_team_doctor(patient_id));
