+create policy jobs_insert_mechanic
+on public.jobs
+for insert
+to authenticated
+with check (
+  status = 'quoted'
+  and public.is_mechanic(garage_id)
+);
+
+create policy jobs_customer_approve
+on public.jobs
+for update
+to authenticated
+using (
+  customer_id = auth.uid()
+  and status = 'quoted'
