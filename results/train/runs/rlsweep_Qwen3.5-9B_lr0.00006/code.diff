+  if v_capacity is null then
+    raise exception 'event not found';
+  end if;
+  select count(*) into v_count
+    from public.rsvps where event_id = new.event_id;
+  if v_count >= v_capacity then
+    raise exception 'event is at capacity';
+  end if;
+  return new;
+end;
