+create or replace function public.is_event_host(p_event_id bigint)
+returns boolean
+language sql
+stable
+security definer
+set search_path = public, pg_temp
+as $$
+  select exists (
+    select 1 from public.events e
+    where e.id = p_event_id and e.host_id = auth.uid()
+  );
+$$;
+
+create or replace function public.is_invited(p_event_id bigint)
+returns boolean
+language sql
+stable
+security definer
+set search_path = public, pg_temp
+as $$
+  select exists (
+    select 1 from public.invites i
+    where i.event_id = p_event_id and i.user_id = auth.uid()
+  );
+$$;
+
+create or replace function public.can_see_event(p_event_id bigint)
+returns boolean
+language sql
+stable
+security definer
+set search_path = public, pg_temp
+as $$
+  select exists (
+    select 1 from public.events e
+    where e.id = p_event_id
+      and (
+        e.is_private = false
+        or e.host_id = auth.uid()
+        or exists (
+          select 1 from public.invites i
+          where i.event_id = e.id and i.user_id = auth.uid()
+        )
+      )
+  );
+$$;
+
+create or replace function public.has_rsvpd(p_event_id bigint)
+returns boolean
+language sql
+stable
+security definer
+set search_path = public, pg_temp
+as $$
+  select exists (
+    select 1 from public.rsvps r
+    where r.event_id = p_event_id and r.user_id = auth.uid()
+  );
+$$;
+
+create or replace function public.event_has_capacity(p_event_id bigint)
+returns boolean
+language sql
+stable
+security definer
+set search_path = public, pg_temp
+as $$
+  select coalesce(
+    (
+      select (select count(*) from public.rsvps r where r.event_id = e.id) < e.capacity
+      from public.events e
+      where e.id = p_event_id
+    ),
+    false
+  );
+$$;
