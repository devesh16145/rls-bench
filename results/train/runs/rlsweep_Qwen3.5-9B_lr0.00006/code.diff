+
+```sql
+alter table public.api_usage enable row level security;
+
+-- R1: authenticated users may read only their own usage rows.
+create policy "api_usage_select_own"
+  on public.api_usage
+  for select
+  to authenticated
+  using ( (select auth.uid()) = user_id );
+
+-- R3 / R4: no write policies exist for anon or authenticated, and no read
+-- policy exists for anon, so those roles get nothing. Make the privilege
+-- layer explicit as well.
+revoke all on public.api_usage from anon;
+revoke insert, update, delete, truncate, references, trigger
+  on public.api_usage from authenticated;
+grant select on public.api_usage to authenticated;
+
+-- R2 / R5: per-user aggregate view. security_invoker makes the view run with
+-- the caller's privileges, so RLS on public.api_usage applies to it: signed-in
+-- users see only their own row, while the service role (BYPASSRLS) sees all.
+create view public.usage_summary
+  with (security_invoker = true)
+  as
+  select
+    u.user_id,
+    sum(u.requests)::bigint as total_requests,
+    count(*)::bigint        as active_days
+  from public.api_usage u
+  group by u.user_id;
+
+revoke all on public.usage_summary from anon;
+grant select on public.usage_summary to authenticated;
+grant select on public.usage_summary to service_role;
+```<|im_end|>
