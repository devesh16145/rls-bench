+-- Helper: is the current session MFA-verified (aal2)?
+create or replace function public.current_session_is_aal2()
+returns boolean
+language sql
+stable
+as $$
+  select coalesce(auth.jwt() ->> 'aal', '') = 'aal2'
+$$;
