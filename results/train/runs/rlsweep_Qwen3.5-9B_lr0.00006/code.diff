+with check (
+  customer_id = auth.uid()
+  and status = 'approved'
+);
+
+create policy jobs_mechanic_update
+on public.jobs
+for update
+to authenticated
+using (
+  public.is_mechanic(garage_id)
+  and status in ('quoted', 'approved', 'in_progress')
+)
+with check (
+  public.is_mechanic(garage_id)
+  and status in ('quoted', 'in_progress', 'done')
