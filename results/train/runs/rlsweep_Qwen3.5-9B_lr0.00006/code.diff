+create or replace function public.send_points(p_to uuid, p_amount integer)
+returns bigint
+language plpgsql
+security definer
+set search_path = public, pg_temp
+as $$
+declare
+  v_from uuid := auth.uid();
+  v_balance integer;
+  v_id bigint;
+begin
+  if v_from is null then
+    raise exception 'send_points: not authenticated';
+  end if;
+
+  if p_to is null then
+    raise exception 'send_points: recipient is required';
+  end if;
+
+  if p_to = v_from then
+    raise exception 'send_points: cannot send points to yourself';
+  end if;
+
+  if p_amount is null or p_amount <= 0 then
+    raise exception 'send_points: amount must be positive';
+  end if;
+
+  -- Lock both wallets in a deterministic order to avoid deadlocks.
+  perform 1 from public.wallets where user_id = least(v_from, p_to) for update;
+  perform 1 from public.wallets where user_id = greatest(v_from, p_to) for update;
+
+  select balance into v_balance
+  from public.wallets
+  where user_id = v_from;
+
+  if v_balance is null then
+    raise exception 'send_points: caller has no wallet';
+  end if;
+
+  if not exists (select 1 from public.wallets where user_id = p_to) then
+    raise exception 'send_points: recipient has no wallet';
+  end if;
+
+  if v_balance < p_amount then
+    raise exception 'send_points: insufficient balance';
+  end if;
+
+  update public.wallets
+     set balance = balance - p_amount
+   where user_id = v_from;
+
+  update public.wallets
+     set balance = balance + p_amount
+   where user_id = p_to;
+
+  insert into public.transfers (from_user, to_user, amount)
+  values (v_from, p_to, p_amount)
+  returning id into v_id;
+
+  return v_id;
+end;
+$$;
