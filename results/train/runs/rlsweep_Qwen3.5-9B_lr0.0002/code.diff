+-- Helper: true only for server-side / moderator roles (bypasses RLS checks on is_pinned)
+create or replace function public.is_moderator()
+returns boolean
+language sql
+stable
+security invoker
+set search_path = ''
+as $$
+  select coalesce(auth.role(), '') = 'service_role'
+      or current_user in ('service_role', 'postgres', 'supabase_admin')
+      or (select auth.uid()) is not null
+      and exists (
+        select 1
+        from pg_catalog.pg_roles r
+        where r.rolname = current_user
+          and r.rolbypassrls
+      );
+$$;
+
+revoke all on function public.is_moderator() from public;
+revoke all on function public.is_moderator() from anon, authenticated;
+grant execute on function public.is_moderator() to authenticated, service_role;
+
+-- R1: anyone can read every note
+create policy "board_notes_select_all"
+on public.board_notes
+for select
+to anon, authenticated
+using (true);
+
+-- R2 / R4: signed-in users can post only as themselves; anon has no insert policy
+create policy "board_notes_insert_own"
+on public.board_notes
+for insert
+to authenticated
+with check (author_id = auth.uid());
+
+-- R2 / R3: authors can edit their own notes; is_pinned can only change via moderator
+create policy "board_notes_update_own"
+on public.board_notes
+for update
+to authenticated
+using (author_id = auth.uid())
+with check (author_id = auth.uid());
+
+-- R3: Defender-like guardian trigger: author_id immutable, is_pinned only by moderator
+create or replace function public.board_notes_guard_update()
+returns trigger
+language plpgsql
+security invoker
+set search_path = ''
+as $$
+begin
+  if new.id is distinct from old.id
+     or new.created_at is distinct from old.created_at then
+    raise exception 'board_notes id and created_at are immutable';
+  end if;
+
+  if new.author_id is distinct from old.author_id
+     and not public.is_moderator() then
+    raise exception 'board_notes author_id can only be changed by a moderator';
+  end if;
+
+  if new.is_pinned is distinct from old.is_pinned
