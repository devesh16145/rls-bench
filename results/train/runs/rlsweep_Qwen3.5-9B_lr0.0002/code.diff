+revoke execute on function public.is_care_team_doctor(bigint) from public, anon;
+revoke execute on function public.owns_patient(bigint) from public, anon;
+grant execute on function public.current_session_is_aal2() to authenticated, service_role;
+grant execute on function public.is_care_team_doctor(bigint) to authenticated, service_role;
