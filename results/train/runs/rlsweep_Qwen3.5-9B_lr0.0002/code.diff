+create or replace function public.is_household_member(p_household_id bigint)
+returns boolean
+language sql
+stable
+security definer
+set search_path = public
+as $$
+  select exists (
+    select 1
+    from public.household_members hm
+    where hm.household_id = p_household_id
+      and hm.user_id = auth.uid()
+  );
+$$;
+
+create or replace function public.shopping_items_enforce_update()
+returns trigger
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_current_claimed_by uuid := new.claimed_by;
+  v_is_bought boolean := new.is_bought;
+  v_added_by uuid := new.added_by;
+begin
+  if auth.role() = 'service_role' or current_user = 'service_role' then
+    return new;
+  end if;
+
+  if new.id is distinct from old.id
+     or new.household_id is distinct from old.household_id
+     or new.name is distinct from old.name then
+    raise exception 'Only claim, unclaim, and bought status can be changed';
+  end if;
+
+  if old.is_bought = true then
+    if new.is_bought = false or new.claimed_by is distinct from old.claimed_by then
+      raise exception 'A bought item cannot be changed';
+    end if;
+    return new;
+  end if;
+
+  if new.added_by is distinct from old.added_by then
+    raise exception 'added_by cannot be changed';
+  end if;
+
+  if old.added_by = auth.uid() then
+    if new.is_bought = true then
+      raise exception 'Only the claimer can mark an item bought';
+    end if;
+    return new;
+  end if;
+
+  if old.claimed_by is null then
+    if new.claimed_by is not null and new.claimed_by = auth.uid() then
+      return new;
+    else
+      raise exception 'Cannot claim an unclaimed item as someone else or leave it unclaimed';
+    end if;
+  elsif old.claimed_by = auth.uid() then
+    if new.claimed_by is null then
+      return new;
+    elsif new.claimed_by = auth.uid() then
+      return new;
+    else
+      raise exception 'Cannot claim an item someone else has claimed';
+    end if;
+  else
+    raise exception 'Cannot change a claimed item';
+  end if;
+end;
+$$;
+
+create trigger shopping_items_enforce_update
+before update on public.shopping_items
+for each row execute function public.shopping_items_enforce_update();
