+-- ---------- loan return integrity trigger (R4) ----------
+create or replace function public.enforce_loan_return_only()
+returns trigger
+language plpgsql
+set search_path = public, pg_temp
+as $$
+begin
+  if old.returned_on is not null then
+    raise exception 'loan % has already been returned', old.id
+      using errcode = 'check_violation';
+  end if;
