+create policy loans_insert_self_with_capacity
+  on public.loans
+  for insert
+  to authenticated
+  with check (
+    borrower_id = auth.uid()
+    and returned_on is null
+    and public.book_has_free_copy(book_id)
+    and public.active_loan_count(auth.uid()) < 3
