+-- ---------------------------------------------------------------------------
+-- Helper functions (security definer so they can read org_members without
+-- recursing through RLS and without exposing other memberships)
+-- ---------------------------------------------------------------------------
+create or replace function public.is_org_member(p_org_id bigint, p_user_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select exists (
+    select 1
+    from public.org_members m
+    where m.org_id = p_org_id
+      and m.user_id = p_user_id
+  );
+$$;
+
+create or replace function public.is_org_admin(p_org_id bigint, p_user_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select exists (
+    select 1
+    from public.org_members m
+    where m.org_id = p_org_id
+      and m.user_id = p_user_id
+      and m.role = 'admin'
+  );
+$$;
+
+create or replace function public.is_record_org_admin(p_record_id bigint, p_user_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select exists (
+    select 1
+    from public.records r
+    join public.org_members m on m.org_id = r.org_id
+    where r.id = p_record_id
+      and m.user_id = p_user_id
+      and m.role = 'admin'
+  );
+$$;
+
+-- ---------------------------------------------------------------------------
+-- Audit trigger: every insert/update of a record writes an audit row.
+-- Security definer so the write succeeds even though no user has write
+-- access to public.audit_log.
+-- ---------------------------------------------------------------------------
+create or replace function public.log_record_audit()
+returns trigger
+language plpgsql
+security definer
+set search_path = ''
+as $$
+begin
+  insert into public.audit_log (record_id, action, actor)
+  values (new.id, pg_catalog.lower(tg_op), auth.uid());
+  return null;
+end;
+$$;
+
+create trigger records_audit_insert_update
+after insert or update on public.records
+for each row execute function public.log_record_audit();
+
+-- ---------------------------------------------------------------------------
+-- restore_record RPC
+-- ---------------------------------------------------------------------------
+create or replace function public.restore_record(p_record_id bigint)
+returns void
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_uid        uuid := auth.uid();
+  v_org_id     bigint;
+  v_deleted_at timestamptz;
+begin
+  if v_uid is null then
+    raise exception 'not authenticated' using errcode = '28000';
+  end if;
+
+  select r.org_id, r.deleted_at
+    into v_org_id, v_deleted_at
+  from public.records r
+  where r.id = p_record_id
+  for update;
+
+  if not found then
+    raise exception 'record % not found', p_record_id using errcode = 'P0002';
+  end if;
+
+  if not public.is_org_admin(v_org_id, v_uid) then
+    raise exception 'not authorized to restore record %', p_record_id using errcode = '42501';
+  end if;
+
+  if v_deleted_at is null then
+    raise exception 'record % is not deleted', p_record_id using errcode = 'P0001';
+  end if;
+
+  if v_deleted_at < pg_catalog.now() - interval '30 days' then
+    raise exception 'record % was deleted more than 30 days ago', p_record_id using errcode = 'P0001';
+  end if;
+
+  update public.records
+     set deleted_at = null
+   where id = p_record_id;
+end;
+$$;
+
+-- ---------------------------------------------------------------------------
+-- Row Level Security
+-- ---------------------------------------------------------------------------
+alter table public.org_members enable row level security;
+alter table public.records     enable row level security;
+alter table public.audit_log   enable row level security;
+
+-- org_members: a user can see only their own membership rows
+create policy org_members_select_own
+on public.org_members
+for select
+to authenticated
+using (user_id = (select auth.uid()));
+
+-- records: members see non-deleted records of their orgs, admins also see deleted
+create policy records_select_member
+on public.records
+for select
+to authenticated
+using (
+  public.is_org_member(org_id, (select auth.uid()))
+  and (
+    deleted_at is null
+    or public.is_org_admin(org_id, (select auth.uid()))
+  )
+);
+
+-- records: members can create records in their orgs; new records are never deleted
+create policy records_insert_member
+on public.records
+for insert
+to authenticated
+with check (
+  deleted_at is null
+  and public.is_org_member(org_id, (select auth.uid()))
+);
+
+-- records: members edit non-deleted records; admins may also soft-delete
+create policy records_update_member_or_admin
+on public.records
+for update
+to authenticated
+using (
+  (deleted_at is null and public.is_org_member(org_id, (select auth.uid())))
+  or public.is_org_admin(org_id, (select auth.uid()))
+)
+with check (
+  public.is_org_member(org_id, (select auth.uid()))
+  and (
+    deleted_at is null
+    or public.is_org_admin(org_id, (select auth.uid()))
+  )
+);
+
+-- no DELETE policy: records are never hard-deleted
+
+-- audit_log: only admins of the record's organization may read
+create policy audit_log_select_admin
+on public.audit_log
+for select
+to authenticated
+using (public.is_record_org_admin(record_id, (select auth.uid())));
+
+-- no INSERT/UPDATE/DELETE policies on audit_log: only the definer trigger writes
+
+-- ---------------------------------------------------------------------------
+-- Grants / revokes
+-- ---------------------------------------------------------------------------
+revoke all on public.org_members from anon;
+revoke all on public.records     from anon;
+revoke all on public.audit_log   from anon;
+
+revoke all on public.org_members from authenticated;
+grant select on public.org_members to authenticated;
+
+revoke all on public.records from authenticated;
+grant select, insert, update on public.records to authenticated;
+
+revoke all on public.audit_log from authenticated;
+grant select on public.audit_log to authenticated;
+
+revoke execute on function public.is_org_member(bigint, uuid)      from public, anon;
+revoke execute on function public.is_org_admin(bigint, uuid)       from public, anon;
+revoke execute on function public.is_record_org_admin(bigint, uuid) from public, anon;
+grant execute on function public.is_org_member(bigint, uuid)       to authenticated, service_role;
+grant execute on function public.is_org_admin(bigint, uuid)        to authenticated, service_role;
+grant execute on function public.is_record_org_admin(bigint, uuid) to authenticated, service_role;
+
+revoke execute on function public.log_record_audit() from public, anon, authenticated;
+
+revoke execute on function public.restore_record(bigint) from public, anon;
+grant execute on function public.restore_record(bigint) to authenticated, service_role;
