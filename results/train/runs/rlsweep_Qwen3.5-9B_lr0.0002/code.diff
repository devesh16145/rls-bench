+-- ---------- helper functions ----------
+create or replace function public.is_librarian()
+returns boolean
+language sql
+stable
+security definer
+set search_path = public, pg_temp
+as $$
+  select exists (
+    select 1 from public.librarians l where l.user_id = auth.uid()
+  );
+$$;
+
+create or replace function public.book_has_free_copy(p_book_id bigint)
+returns boolean
+language sql
+stable
+security definer
+set search_path = public, pg_temp
+as $$
+  select exists (
+    select 1
+    from public.books b
+    where b.id = p_book_id
+      and b.copies > (
+        select count(*)
+        from public.loans l
+        where l.book_id = b.id
+          and l.returned_on is null
+      )
+  );
+$$;
+
+create or replace function public.active_loan_count(p_user uuid)
+returns integer
+language sql
+stable
+security definer
+set search_path = public, pg_temp
+as $$
+  select count(*)::integer
+  from public.loans l
+  where l.borrower_id = p_user
+    and l.returned_on is null;
